<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <PropertyGroup>
    <ExtensionBinDir>$(ProjectDir)..\winforms-designer-extension\bin</ExtensionBinDir>
  </PropertyGroup>

  <!-- Replaces an `xcopy` Exec, which made the build Windows-only. MSBuild's Copy
       task does the same job on macOS and Linux. -->
  <Target Name="CopyDesignerToExtension" AfterTargets="Build">
    <ItemGroup>
      <BuiltDesignerFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltDesignerFiles)"
          DestinationFiles="@(BuiltDesignerFiles->'$(ExtensionBinDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- macOS/Linux use a self-contained publish, so mirror that output too. -->
  <Target Name="CopyPublishedDesignerToExtension" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDesignerFiles Include="$(PublishDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedDesignerFiles)"
          DestinationFiles="@(PublishedDesignerFiles->'$(ExtensionBinDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>